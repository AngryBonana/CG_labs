{
	"version": 2,
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {}
		},
		{
			"name": "debug",
			"inherits": "common",
			"binaryDir": "build-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"inherits": "common",
			"binaryDir": "build-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "msvc-debug",
			"inherits": "debug",
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "msvc-release",
			"inherits": "release",
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "mingw-debug",
			"displayName": "MinGW Debug",
			"description": "Debug build with MinGW",
			"generator": "MinGW Makefiles",
			"binaryDir": "${sourceDir}/build-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_C_COMPILER": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
				"CMAKE_CXX_COMPILER": "C:\\msys64\\ucrt64\\bin\\g++.exe",
				"CMAKE_MAKE_PROGRAM": "C:\\msys64\\ucrt64\\bin\\mingw32-make.exe"
			}
		},
		{
			"name": "mingw-release",
			"inherits": "release",
			"generator": "MinGW Makefiles"
		}
	]
}
